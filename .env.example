# Portforge Cyber — Environment Variables
# Copy this file to .env.local if needed.
# LLM credentials are server-only: the browser never receives them.

# LLM — server-only. Set the key (and optionally the base URL) for the style you use.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
#   Point OPENAI_BASE_URL at any OpenAI-compatible gateway (Groq, Moonshot, GLM,
#   NVIDIA NIM, a local server) to use that provider through the openai style.

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#   Point ANTHROPIC_BASE_URL at an Anthropic-compatible gateway if needed.

# Optional: require x-proxy-secret on every /api/llm/proxy request
# PROXY_SECRET=

# Optional: GitHub Personal Access Token for future PR sync integration
# GITHUB_TOKEN=
