# ─────────────────────────────────────────────
# Portforge — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database (Supabase → Settings → Database → Transaction pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres

# Anthropic API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payments (lemonsqueezy.com) ──────────────
# Settings → API → API Keys
LEMONSQUEEZY_API_KEY=
# Your store ID (from store URL)
LEMONSQUEEZY_STORE_ID=
# Settings → Webhooks → Signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=
# Product variant IDs (from your product pages)
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_AUDIT_VARIANT_ID=

# ── GitHub (optional) ────────────────────────
# Increases rate limit for public repo fetching
# github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=
